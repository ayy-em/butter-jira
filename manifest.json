{
  "manifest_version": 3,
  "name": "butter_jira",
  "version": "0.6.0",
  "description": "Visualize your Jira in a Gantt chart, using a backlog list or Kanban views across all your Jira boards, run an efficient daily standup, and see your team's GitHub activity. Fast, lean, no AI. ButterJira: Fighting bloat since 2026.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.atlassian.net/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "assets/logo-16.png",
    "32": "assets/logo-32.png",
    "48": "assets/logo-48.png",
    "128": "assets/logo.png"
  },
  "action": {
    "default_title": "butter_jira",
    "default_icon": {
      "16": "assets/logo-16.png",
      "32": "assets/logo-32.png",
      "48": "assets/logo-48.png",
      "128": "assets/logo.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'"
  },
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "minimum_chrome_version": "111"
}
